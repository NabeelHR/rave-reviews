DATABASE_URL=postgres://rr:rr@localhost:5432/ravereviews
PORT=3000

# RR-3 auth
# Where magic links point (the frontend). Dev = Vite dev server.
APP_URL=http://localhost:5173
# Comma-separated user UUIDs granted admin. Empty = no admins.
# Local dev: alice's stable seed id.
ADMIN_IDS=00000000-0000-4000-8000-000000000001

# RR-35 production email (magic links). Precedence: Resend → Gmail → console
# (console = links print to the server log — the dev default).
#
# Free path, no domain needed: your Gmail + an App Password
# (Google Account → Security → 2-Step Verification → App passwords).
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
#
# Custom-domain path (Resend; requires a verified domain there):
# RESEND_API_KEY=re_...
# EMAIL_FROM="Rave Reviews <login@yourdomain.com>"
